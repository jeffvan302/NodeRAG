# Copy this file to .env only when overriding a local default.
# Do not place passwords, tokens, production paths, or private document data here.

NODERAG_TESTBED_DB_PORT=55432
NODERAG_TESTBED_POSTGRES_DB=noderag_test
NODERAG_TESTBED_POSTGRES_USER=noderag_test
NODERAG_TESTBED_POSTGRES_IMAGE=pgvector/pgvector@sha256:cf134a767f474095eeba57e0117be8e568e011a63f33fbf252f14c9b760f8e6f

# Milestone 1 feasibility defaults. Keep content on the LAN unless an operator
# explicitly approves another boundary.
NODERAG_M01_MEMORY_LIMIT=8g
NODERAG_M01_CPU_LIMIT=12
NODERAG_M01_OLLAMA_URL=http://host.docker.internal:11434
NODERAG_M01_OLLAMA_MODEL=
NODERAG_M01_OLLAMA_PARALLEL=1
NODERAG_M01_CONTENT_MAY_LEAVE_LAN=false
