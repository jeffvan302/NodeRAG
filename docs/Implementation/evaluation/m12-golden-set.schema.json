{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noderag.local/schemas/evaluation-golden-set.v2.json",
  "title": "NodeRag curated evaluation golden set",
  "type": "object",
  "required": [
    "version",
    "id",
    "corpusManifest",
    "curatedAt",
    "curator",
    "synthetic",
    "sourcePlanningFiles",
    "cases"
  ],
  "properties": {
    "version": { "const": 2 },
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "corpusManifest": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "curatedAt": { "type": "string", "format": "date-time" },
    "curator": { "type": "string", "minLength": 1, "maxLength": 160 },
    "synthetic": { "const": false },
    "sourcePlanningFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "cases": {
      "type": "array",
      "minItems": 50,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "silo", "query", "queryClass", "expectedFormat", "answerable", "relevant"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "silo": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "query": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "queryClass": {
          "enum": [
            "semantic",
            "exact_identifier",
            "exact_name",
            "error_code",
            "quoted_phrase",
            "cross_page",
            "table",
            "vision",
            "multilingual",
            "unicode"
          ]
        },
        "expectedFormat": { "enum": ["pdf", "docx", "xlsx", "txt", "md"] },
        "answerable": { "type": "boolean" },
        "relevant": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relevantDocument" }
        },
        "notes": { "type": "string", "maxLength": 4000 }
      },
      "additionalProperties": false
    },
    "relevantDocument": {
      "type": "object",
      "required": ["document", "sha256"],
      "properties": {
        "document": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "sheets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      },
      "additionalProperties": false,
      "not": { "required": ["pages", "sheets"] }
    }
  }
}
