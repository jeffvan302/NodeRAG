{
  "name": "@noderag/server",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build-server.mjs",
    "dev:api": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "tsx src/store/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "@napi-rs/canvas": "1.0.8",
    "@noderag/adapter-dsm": "workspace:*",
    "@noderag/adapter-local": "workspace:*",
    "@noderag/shared": "workspace:*",
    "chardet": "2.2.0",
    "fast-xml-parser": "5.11.1",
    "fastify": "5.12.1",
    "hash-wasm": "4.12.0",
    "iconv-lite": "0.7.3",
    "node-pg-migrate": "9.0.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "saxes": "6.0.0",
    "unzipper": "0.12.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/unzipper": "0.10.11"
  }
}
