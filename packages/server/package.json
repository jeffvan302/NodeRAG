{
  "name": "@noderag/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build-server.mjs",
    "dev:api": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "tsx src/store/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noderag/adapter-dsm": "workspace:*",
    "@noderag/adapter-local": "workspace:*",
    "@noderag/shared": "workspace:*",
    "fastify": "5.12.1",
    "hash-wasm": "4.12.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
