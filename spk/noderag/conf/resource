{
  "data-share": {
    "shares": [
      {
        "name": "NodeRag",
        "permission": { "rw": ["noderag"] },
        "once": true
      }
    ]
  },
  "port-config": {
    "protocol-file": "port_conf/NodeRag.sc"
  },
  "webservice": {
    "services": [
      {
        "service": "noderag",
        "display_name": "NodeRag",
        "type": "reverse_proxy",
        "icon": "ui/images/icon_{0}.png",
        "proxy_target": "http://127.0.0.1:8787",
        "proxy_headers": [
          { "name": "X-Forwarded-Host", "value": "$http_host" },
          { "name": "X-Forwarded-Proto", "value": "$scheme" },
          { "name": "X-Forwarded-For", "value": "$proxy_add_x_forwarded_for" }
        ]
      }
    ],
    "portals": [
      {
        "service": "noderag",
        "name": "noderag",
        "display_name": "NodeRag",
        "app": "SYNO.SDS.NodeRag",
        "type": "alias",
        "alias": "noderag"
      }
    ],
    "pkg_dir_prepare": []
  }
}
