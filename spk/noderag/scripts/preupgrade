#!/bin/sh
set -eu
script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [ -n "${SYNOPKG_PKGVAR:-}" ] && [ -f "${SYNOPKG_PKGVAR}/postgres/data/PG_VERSION" ]; then
  installed_major="$(cat "${SYNOPKG_PKGVAR}/postgres/data/PG_VERSION")"
  [ "${installed_major}" = "17" ] || {
    echo "NodeRag upgrade requires PostgreSQL major 17; found ${installed_major}." >&2
    exit 78
  }
  mkdir -p "${SYNOPKG_PKGVAR}/upgrade"
  printf 'postgresql=17\nstarted_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >"${SYNOPKG_PKGVAR}/upgrade/preupgrade.state"
fi
"${script_dir}/start-stop-status" stop
